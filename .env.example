# ==============================================================================
# Dijital Sadakat Kartı — Örnek Ortam Değişkenleri
# Kullanım: Bu dosyayı `.env` adıyla kopyalayıp kendi değerlerinizi yazın.
# ==============================================================================

# 1. VERİTABANI & ZORUNLU GÜVENLİK
# ------------------------------------------------------------------------------
# SQLite Veritabanı Klasörü (Docker içinde /data, yerelde ./data)
DATA_DIR=/data

# Zorunlu Güvenlik Anahtarı (boş bırakılırsa uygulama başlamaz)
# Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=buraya_en_az_32_karakterli_rastgele_bir_anahtar_yazin


# 2. MARKA VE SADAKAT PROGRAMI (İlk kurulum varsayılanları)
# ------------------------------------------------------------------------------
BUSINESS_NAME=Kahve Dükkanım
ACCENT_COLOR=#1E4D3F
REWARD_NAME=1 İkram El Yapımı Kahve
STAMP_TARGET=5


# 3. YÖNETİM VE KASA PANELLERİ (İlk Kurulum)
# ------------------------------------------------------------------------------
# İlk 'mudur' hesabı parolası. Boşsa rastgele üretilip başlangıç günlüğüne 1 kez yazılır.
MANAGER_PASSWORD=
# İlk 'kasa1' kasiyer hesabı parolası (boşsa açılmaz; müdür sonradan panelden ekler).
STAFF_PASSWORD=
# İsteğe bağlı önceden basılı kasa QR mührü token'ı (ör. /m/<token>); boşsa panelden oluşturulur.
STAMP_SEAL_TOKEN=


# 4. UYGULAMA ADRESİ VE PORT
# ------------------------------------------------------------------------------
# QR kodlar ve bildirim bağlantıları için temel adres:
PUBLIC_BASE_URL=http://localhost:8000
# Kök yolda yayın için boş bırakın; ters vekil altında alt yoldaysa önek yazın (ör. /k):
PUBLIC_BASE_PATH=
# Docker host port eşlemesi (varsayılan 8000):
APP_PORT=8000


# 5. WEB PUSH (VAPID) — Opsiyonel
# ------------------------------------------------------------------------------
# Üretmek için: python -m app.vapid_gen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
