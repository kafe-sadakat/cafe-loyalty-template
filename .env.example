# ==============================================================================
# Dijital Sadakat Kartı — Örnek Ortam Değişkenleri
# Kullanım: Bu dosyayı `.env` adıyla kopyalayıp kendi değerlerinizi yazın.
# ==============================================================================

# 1. VERİTABANI & ZORUNLU GÜVENLİK
# ------------------------------------------------------------------------------
# SQLite Veritabanı Klasörü (Docker içinde /data, yerelde ./data)
DATA_DIR=/data

# Zorunlu Güvenlik Anahtarı (boş bırakılırsa uygulama başlamaz)
# Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=buraya_en_az_32_karakterli_rastgele_bir_anahtar_yazin


# 2. MARKA VE SADAKAT PROGRAMI (İlk kurulum varsayılanları)
# ------------------------------------------------------------------------------
BUSINESS_NAME=Kahve Dükkanım
ACCENT_COLOR=#1E4D3F
REWARD_NAME=1 İkram El Yapımı Kahve
STAMP_TARGET=5


# 3. YÖNETİM VE KASA PANELLERİ (İlk Kurulum)
# ------------------------------------------------------------------------------
# İlk 'mudur' hesabı parolası. Boşsa rastgele üretilip başlangıç günlüğüne 1 kez yazılır.
MANAGER_PASSWORD=
# İlk 'kasa1' kasiyer hesabı parolası (boşsa açılmaz; müdür sonradan panelden ekler).
STAFF_PASSWORD=
# İsteğe bağlı önceden basılı kasa QR mührü token'ı (ör. /m/<token>); boşsa panelden oluşturulur.
STAMP_SEAL_TOKEN=


# 4. ALAN ADI VE ALT YOL (PUBLIC URL & SUBPATH)
# ------------------------------------------------------------------------------
# QR kodlar ve bildirim bağlantıları için herkese açık adres:
PUBLIC_BASE_URL=http://localhost:8000
# Kök yolda yayın için boş bırakın; Caddy arkasında alt yoldaysa önek yazın (ör. /k):
PUBLIC_BASE_PATH=
# Docker host port eşlemesi (varsayılan 8000):
APP_PORT=8000


# 5. CLOUDFLARE PAGES / WORKER KENAR VEKİLİ (Opsiyonel)
# ------------------------------------------------------------------------------
# Cloudflare Pages projenizin varsayılan alan adı (ör. kafem.pages.dev)
EDGE_DEFAULT_HOST=
# Kenar vekilinin yönlendireceği özel alan adları (virgülle ayrılmış, ör. kafem.com,www.kafem.com)
EDGE_ALLOWED_HOSTS=
# Cloudflare ile paylaşılan sır (X-Edge-Auth). Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(32))"
EDGE_SHARED_SECRET=
# Eski/ikincil alan adları varsa push bildirim hedef doğrulaması için ekleyin (virgülle ayrılmış):
EXTRA_PUBLIC_HOSTS=


# 6. WEB PUSH (VAPID) — Opsiyonel
# ------------------------------------------------------------------------------
# Üretmek için: python -m app.vapid_gen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com


# 7. OTOMATİK SUNUCU DAĞITIMI (`auto_deploy.py` için `.env.deploy` içinde tutun)
# ------------------------------------------------------------------------------
DEPLOY_SSH_KEY=
DEPLOY_REMOTE_HOST=
DEPLOY_REMOTE_DIR=/home/ubuntu/cafe-loyalty
DEPLOY_VERIFY_BASE_URL=http://127.0.0.1:8000
DEPLOY_VERIFY_BASE_PATH=
CF_PROJECT_NAME=


# 8. POSTGRESQL & DIRECTUS ENTEGRASYONU (Opsiyonel / Varsayılan Kapalı)
# ------------------------------------------------------------------------------
ENABLE_DIRECTUS_SYNC=0
PG_HOST=db
PG_PORT=5432
PG_DB=directus
PG_USER=directus
PG_PASSWORD=
DIRECTUS_INTERNAL_URL=http://directus:8055
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=
ADMIN_PASSWORD=
