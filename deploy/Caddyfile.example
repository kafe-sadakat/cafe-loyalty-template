# Caddy ters vekil örnek yapılandırması (Oracle VPS vb.)
# 1) Kök alan adında doğrudan yayın (PUBLIC_BASE_PATH=):
#
# ornek-kafe.com {
#     reverse_proxy sadakat:8000 {
#         header_up X-Real-IP {remote_host}
#     }
# }
#
# 2) Alt yolda yayın (örn. Directus ile aynı sunucuda /k/* altında, PUBLIC_BASE_PATH=/k):

sunucunuz.duckdns.org {
    handle_path /k* {
        reverse_proxy sadakat:8000 {
            header_up X-Real-IP {remote_host}
        }
    }

    # İsteğe bağlı: kök / isteğini /k/ sayfasına yönlendirmek isterseniz:
    # handle / {
    #     redir /k/ 302
    # }
}
