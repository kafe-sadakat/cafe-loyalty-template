# Özel alan adını doğrudan Cloudflare Worker olarak yönlendirmek isterseniz:
# Bu dosyayı `wrangler.worker.toml` adıyla kopyalayıp kendi alan adlarınızı girin,
# ardından `wrangler secret put ... --config wrangler.worker.toml` ile gizli değişkenleri ekleyin.

name = "cafe-loyalty-domain"
main = "functions/[[path]].js"
compatibility_date = "2026-01-01"
workers_dev = false

routes = [
  { pattern = "ornek-kafe.com", custom_domain = true },
  { pattern = "www.ornek-kafe.com", custom_domain = true }
]
