# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Secrets
.env
.env.*
!.env.example
venv/
.venv/
env/
ENV/

# Deployment & Keys
.env.deploy
*.key
*.pem
SSH-KEY/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
*.cover

# Databases & Runtime Data
data/*
!data/.gitkeep
*.db
*.sqlite
*.sqlite3

# Archives & Compressed bundles (eski dağıtım paketleri dahil)
*.tgz
*.tar.gz
*.zip
*.rar

# OS & Editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Temporary scripts
scan_secrets.py
fix_test_line.py
